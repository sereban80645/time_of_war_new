<?xml version="1.0" encoding="utf-8"?>

<manifest
    xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
         Дозвіл на точні alarm.
         На Android 12+ користувач повинен
         дозволити його через:
         Налаштування →
         Програми →
         Спеціальний доступ →
         Будильники та нагадування.
    -->
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!--
         Дозвіл на запуск receiver після
         перезавантаження телефона.
    -->
    <uses-permission
        android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:label="time_of_war"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">

            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />

            <intent-filter>

                <action
                    android:name="android.intent.action.MAIN" />

                <category
                    android:name="android.intent.category.LAUNCHER" />

            </intent-filter>

        </activity>

        <!--
             Основний HomeScreen Widget.
        -->
        <receiver
            android:name=".WidgetProvider"
            android:exported="true">

            <intent-filter>

                <action
                    android:name="android.appwidget.action.APPWIDGET_UPDATE" />

            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info" />

        </receiver>

        <!--
             Наш автономний погодинний/добовий timer.
        -->
        <receiver
            android:name=".HourlyWidgetUpdateReceiver"
            android:exported="true">

            <intent-filter>

                <!-- Після перезавантаження телефона -->
                <action
                    android:name="android.intent.action.BOOT_COMPLETED" />

                <!-- Після оновлення APK -->
                <action
                    android:name="android.intent.action.MY_PACKAGE_REPLACED" />

                <!-- Після надання доступу до точних alarm -->
                <action
                    android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />

                <!-- Наш власний alarm -->
                <action
                    android:name="com.example.time_of_war.HOURLY_WIDGET_UPDATE" />

                <!-- Скасування alarm -->
                <action
                    android:name="com.example.time_of_war.CANCEL_HOURLY_UPDATE" />

            </intent-filter>

        </receiver>

        <!--
             HomeWidget background callback.
        -->
        <receiver
            android:name="es.antonborri.home_widget.HomeWidgetBackgroundReceiver"
            android:exported="true">

            <intent-filter>

                <action
                    android:name="es.antonborri.home_widget.action.BACKGROUND" />

            </intent-filter>

        </receiver>

        <service
            android:name="es.antonborri.home_widget.HomeWidgetBackgroundService"
            android:permission="android.permission.BIND_JOB_SERVICE"
            android:exported="true" />

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

    </application>

</manifest>
